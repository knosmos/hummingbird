 159:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_ll_usb.c ****       /* hclk Clock Range between 27.7-32 MHz */
 160:Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_ll_usb.c ****       UsbTrd = 0x7U;
